# Local runtime configuration
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEMPERATURE=0.7
OLLAMA_MODEL_CLASSIFY=gemma2:2b
OLLAMA_MODEL_SENTIMENT=gemma2:2b
OLLAMA_MODEL_SUMMARIZE=gemma2:2b
OLLAMA_MODEL_INTENT=gemma2:2b

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Docker Hub / CI profile
DOCKERHUB_USERNAME=replace-with-your-dockerhub-username
